{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "typeRoots": [
      "../web/node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "../web/node_modules/*"
      ]
    }
  },
  "include": [
    "."
  ]
}
